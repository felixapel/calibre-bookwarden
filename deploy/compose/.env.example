# Copy to .env and edit. Never commit .env.

# The image tag. Pin a release (see the changelog), not a moving tag.
BOOKWARDEN_VERSION=v2.0.0
# Port on this host that serves the web UI.
BOOKWARDEN_PORT=8399

# Postgres password: a long random string of letters and digits only, such as
# the output of `openssl rand -hex 24`. The same value goes into the database
# URL and to Postgres itself, and percent-encoding would make them differ.
POSTGRES_PASSWORD=change-me

# Your Calibre content server, as this container reaches it, such as
# http://192.0.2.20:8081. From a container, "localhost" is the container
# itself: use the host's LAN address, or a container name on a network you
# attach the service to.
BOOKWARDEN_CALIBRE_URL=change-me
# The Calibre account Bookwarden uses, and its password. Keep the account
# read-only until you want fixes.
BOOKWARDEN_CALIBRE_USER=bookwarden
BOOKWARDEN_CALIBRE_PASSWORD=change-me
# Empty means the server's default library.
BOOKWARDEN_CALIBRE_LIBRARY=

# The host names or IPs you open Bookwarden by, comma-separated, no port, such
# as 192.0.2.10,nas.local. Any other name in the address bar is refused.
BOOKWARDEN_ALLOWED_HOSTS=change-me

# Optional.
BOOKWARDEN_LOG_LEVEL=info
# Daily incremental check (HH:MM) and weekly full check (for example "sun 04:00"),
# read in TZ. Empty is off.
BOOKWARDEN_SCHEDULE_INCREMENTAL=
BOOKWARDEN_SCHEDULE_FULL=
TZ=Europe/Berlin
# Uptime Kuma push URL (holds a secret token), and the exact address it may
# dial when it is plain http or private, such as <kuma-ip>/32.
BOOKWARDEN_HEARTBEAT_URL=
BOOKWARDEN_HEARTBEAT_ALLOW_CIDR=

# Optional: how many of the newest runs to keep (default 10, 0 keeps all).
BOOKWARDEN_RETAIN_RUNS=
# Only behind a reverse proxy: its IP addresses or CIDRs (no wider than /16, or /48 for IPv6).
BOOKWARDEN_TRUSTED_PROXIES=
# A token of at least 32 characters turns on /metrics.
BOOKWARDEN_METRICS_TOKEN=
# Metadata source keys. Without them those sources are off.
BOOKWARDEN_GOOGLE_BOOKS_KEY=
BOOKWARDEN_HARDCOVER_TOKEN=
# The extractors' endpoint: a key for opencode-go, or a gateway's base URL
# (with the gateway's exact address in ALLOW_CIDR if it is on the LAN).
# Empty means no extractor runs.
BOOKWARDEN_EXTRACTOR_KEY=
BOOKWARDEN_EXTRACTOR_BIFROST_URL=
BOOKWARDEN_EXTRACTOR_ALLOW_CIDR=
