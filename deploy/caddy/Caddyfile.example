{
	# Runtime changes are deployed by replacing this container. Do not expose a
	# mutable administration API to other host processes.
	admin off
}

{$BOOKAUDIT_DOMAIN} {
	tls {
		get_certificate tailscale
	}
	# This directive has no path matcher: authentication covers the SPA, assets,
	# API, metrics, health endpoints, and every future route.
	basic_auth {
		{$BOOKAUDIT_BASIC_AUTH_USER} {$BOOKAUDIT_BASIC_AUTH_HASH}
	}

	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	# Reach the backend only through the private Compose network. Host exposure is
	# independently limited to the app's existing loopback publication.
	reverse_proxy app:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
