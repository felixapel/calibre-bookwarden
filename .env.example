# Copy to .env, replace every placeholder, then chmod 600 .env.
UID=1000
GID=1000
# Keep Certificate A isolated from legacy/shadow Compose projects and their
# quarantined writer containers.
COMPOSE_PROJECT_NAME=bookaudit-certificate-a

# Certificate A source: stop Calibre before every run. Only the verifier mounts
# this directory, and only read-only.
BOOKAUDIT_LIBRARY_HOST_PATH=/absolute/path/to/calibre-library
BOOKAUDIT_BACKUP_HOST_PATH=./backups
BOOKAUDIT_PORT=8080
BOOKAUDIT_PROMETHEUS_PORT=19090

POSTGRES_PASSWORD=replace-with-a-distinct-long-admin-password
POSTGRES_APP_PASSWORD=replace-with-a-distinct-long-app-password
POSTGRES_VERIFIER_PASSWORD=replace-with-a-distinct-long-verifier-password
POSTGRES_WRITER_PASSWORD=replace-with-a-distinct-long-writer-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-distinct-long-migrator-password

BOOKAUDIT_APP_POSTGRES_DSN=postgresql+psycopg://bookaudit_app:replace-app-password@postgres:5432/bookaudit
BOOKAUDIT_VERIFIER_POSTGRES_DSN=postgresql+psycopg://bookaudit_verifier:replace-verifier-password@postgres:5432/bookaudit
BOOKAUDIT_WRITER_POSTGRES_DSN=postgresql+psycopg://bookaudit_writer:replace-writer-password@postgres:5432/bookaudit
BOOKAUDIT_MIGRATOR_POSTGRES_DSN=postgresql+psycopg://bookaudit_migrator:replace-migrator-password@postgres:5432/bookaudit

BOOKAUDIT_API_KEY=replace-with-at-least-32-random-characters
# Keep both loopback names for container health and same-host Prometheus, then
# add the exact private DNS/VPN name Caddy forwards.
BOOKAUDIT_TRUSTED_HOSTS=localhost,127.0.0.1,app,books.example.test

# Production requires an immutable image and the matching runtime digest.
BOOKAUDIT_IMAGE=registry.example.test/calibre-ai-auditor@sha256:<64-hex-digest>
BOOKAUDIT_RELEASE_DIGEST=sha256:<same-64-hex-digest>
# Exact 40-character commit embedded in the image's OCI revision label.
BOOKAUDIT_SOURCE_REVISION=<40-hex-git-commit>
# Local build/test only; scripts reject mutable images unless this is true.
BOOKAUDIT_ALLOW_LOCAL_IMAGE=false

# Certificate A is shadow-only. The writer profile remains disabled unless an
# operator explicitly starts it for a later Certificate B rehearsal.
BOOKAUDIT_MANIFESTATION_V2__AUTO_APPLY__ENABLED=false
BOOKAUDIT_MANIFESTATION_V2__SUPERVISED_PILOT__ENABLED=false
