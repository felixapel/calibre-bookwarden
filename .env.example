UID=1000
GID=1000
OLLAMA_BASE_URL=http://192.168.0.122:11434/v1
BOOKAUDIT_READ_ONLY=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
BOOKAUDIT_LIBRARY_PATH=/library
BOOKAUDIT_LIBRARY_HOST_PATH=/absolute/path/to/calibre-library
BOOKAUDIT_PORT=8080
BOOKAUDIT_DB_PATH=/state/bookaudit.db
BOOKAUDIT_ARTIFACTS_DIR=/artifacts
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_APP_PASSWORD=replace-with-a-distinct-long-random-password
POSTGRES_WRITER_PASSWORD=replace-with-a-distinct-long-random-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-distinct-long-random-password
BOOKAUDIT_APP_POSTGRES_DSN=postgresql+psycopg://bookaudit_app:replace-app-password@postgres:5432/bookaudit
BOOKAUDIT_WRITER_POSTGRES_DSN=postgresql+psycopg://bookaudit_writer:replace-writer-password@postgres:5432/bookaudit
BOOKAUDIT_MIGRATOR_POSTGRES_DSN=postgresql+psycopg://bookaudit_migrator:replace-migrator-password@postgres:5432/bookaudit
BOOKAUDIT_API_KEY=replace-with-at-least-32-random-characters
BOOKAUDIT_TRUSTED_HOSTS=localhost,127.0.0.1
BOOKAUDIT_REQUIRE_WRITER_READY=true
BOOKAUDIT_IMAGE=calibre-ai-auditor:1.2.0
# Set true only for a local build-and-test deployment; production requires @sha256.
BOOKAUDIT_ALLOW_LOCAL_IMAGE=false
BOOKAUDIT_LOG_LEVEL=INFO
BOOKAUDIT_LOG_JSON=true
BOOKAUDIT_ALLOW_REMOTE_FILE_UPLOAD=false
PAPERLESS_WEBHOOK_SECRET=
